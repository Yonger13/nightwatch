# ============================================================================
# Nightwatch 环境变量模板
# ============================================================================
# 用法：
#   1. 把本文件复制为 .env        （注意前面有个点）
#       复制后 .env 会被 .gitignore 忽略，**不会**被提交到 git
#   2. 填入你的 key
#   3. 跑 python scripts/check_api.py 验证
#
# 为什么用 .env 而不是每次 export？
#   export 容易忘。忘了之后程序会**静默降级**到 Mock 模型 ——
#   你以为在用真实模型跑评测，实际跑的是规则版，而结果看起来"很正常"。
#   静默降级是配置问题里最危险的一类。
# ============================================================================

# --- 必需：API Key ---
# 任何兼容 OpenAI 协议的服务都可以
NW_LLM_API_KEY=

# --- 可选：服务地址（不填则用阿里百炼）---
# 阿里百炼  https://dashscope.aliyuncs.com/compatible-mode/v1
# DeepSeek  https://api.deepseek.com/v1
# Moonshot  https://api.moonshot.cn/v1
# 智谱      https://open.bigmodel.cn/api/paas/v4
# OpenAI    https://api.openai.com/v1
# 本地 vLLM http://localhost:8000/v1
# NW_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# --- 可选：三档模型名 ---
# 如果默认名（qwen-turbo / qwen-plus / qwen-max）在你的服务上不存在，
# 在这里逐个指定。
#
# 三档的用途（见 config.MODEL_ROUTING）：
#   STRONG —— 主循环决策（agent_step）。**唯一真正需要强模型的环节**
#   MEDIUM —— 记忆冲突消解、评测裁判
#   SMALL  —— 记忆抽取、打分（调用量最大，成本敏感）
#
# 举例（DeepSeek 只有一个模型时，三档填同一个也行）：
#   NW_MODEL_STRONG=deepseek-chat
#   NW_MODEL_MEDIUM=deepseek-chat
#   NW_MODEL_SMALL=deepseek-chat
#
# NW_MODEL_STRONG=
# NW_MODEL_MEDIUM=
# NW_MODEL_SMALL=

# --- 可选：GitHub Token（第 0 周采集 issue 时用）---
# 不填的话 GitHub API 限速 60 次/小时，采不了多少数据
# 生成方式：GitHub → Settings → Developer settings → Personal access tokens
# 只需要 public_repo 权限（或者只读权限）
NW_GITHUB_TOKEN=

# ============================================================================
# 提醒
# ============================================================================
# · 不要把这个文件改名为能被 git 追踪的名字（比如 .env.bak 之外的都不要）
# · 提交代码前检查一遍：git status 里不应该出现任何带 key 的文件
# · 如果 key 泄漏了，立刻去服务商后台吊销并重新生成
# ============================================================================
